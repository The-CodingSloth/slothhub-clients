{
  "name": "slothhub-mcp-server",
  "version": "0.1.0",
  "mcpName": "io.github.The-CodingSloth/slothhub-mcp-server",
  "type": "module",
  "description": "Official read-only Sloth Hub MCP server for public catalog feeds (stdio and hosted Streamable HTTP).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-CodingSloth/slothhub-clients.git",
    "directory": "packages/slothhub-mcp-server"
  },
  "homepage": "https://github.com/The-CodingSloth/slothhub-clients/tree/main/packages/slothhub-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/The-CodingSloth/slothhub-clients/issues"
  },
  "bin": {
    "slothhub-mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "server.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp run build:library",
    "test": "vp run test:all",
    "type-check": "node ../../tools/check-types.mjs ./node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "26.6.4",
    "esbuild": "^0.28.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "@slothhub/domain": "workspace:*"
  }
}
